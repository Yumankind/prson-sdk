{
  "name": "@prson/login-verifier",
  "version": "0.1.0",
  "description": "Node.js verifier for SD-JWT-VC presentations issued by the Prson notary and delivered via @prson/login-sdk. Pure-function; no Prson account or API key required.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/status.test.js && node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "sd-jwt-vc",
    "verifiable-credentials",
    "prson",
    "did-web",
    "verifier"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yumankind/prson-sdk.git",
    "directory": "packages/verifier-node"
  },
  "license": "Apache-2.0",
  "author": "Yumankind OÜ <support@prson.net>",
  "homepage": "https://prson.net/developers",
  "bugs": {
    "url": "https://github.com/Yumankind/prson-sdk/issues",
    "email": "security@yumankind.com"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
