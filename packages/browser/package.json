{
  "name": "@prson/login-sdk",
  "version": "0.1.0",
  "private": false,
  "description": "Frontend-first sign-in SDK that delivers a verifiable credential from a Prson mobile wallet to your website over an end-to-end-encrypted WebRTC channel. See README.md.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --format=esm --target=es2020 --platform=browser --outfile=dist/index.js --sourcemap",
    "build:example": "esbuild src/index.ts --bundle --format=esm --target=es2020 --platform=browser --outfile=../../examples/plain-html/prson-login.js --sourcemap",
    "watch:example": "esbuild src/index.ts --bundle --format=esm --target=es2020 --platform=browser --outfile=../../examples/plain-html/prson-login.js --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/session.test.js dist/status.test.js dist/notify.test.js"
  },
  "dependencies": {
    "@stablelib/base64": "^1.0.1",
    "@stablelib/nacl": "^1.0.4",
    "@stablelib/random": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "sd-jwt-vc",
    "verifiable-credentials",
    "openid4vp",
    "passwordless",
    "prson",
    "webrtc",
    "cloudflare-turn",
    "sign-in"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Yumankind/prson-network",
    "directory": "login-sdk/packages/browser"
  },
  "license": "TBD"
}
